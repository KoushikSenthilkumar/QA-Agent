# ─────────────────────────────────────────────────────────────────────────────
# QA Agent — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# VLM Provider settings
# Set VLM_PROVIDER=mock to run without AI credits (full pipeline, mock AI responses)
VLM_PROVIDER=openai
VLM_API_KEY=your_openai_api_key_here
VLM_MODEL=gpt-4o

# Optional: Azure OpenAI endpoint (leave blank to use standard OpenAI)
# VLM_AZURE_ENDPOINT=
# VLM_AZURE_API_VERSION=2024-02-01

# Browser settings
BROWSER_TYPE=chromium
HEADLESS=true

# Logging
LOG_LEVEL=INFO
